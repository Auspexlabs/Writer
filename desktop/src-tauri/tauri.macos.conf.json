{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "externalBin": ["binaries/writer", "binaries/writer-vision"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "./entitlements/Writer.entitlements"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://thewriter.cn/updates/mac/latest.json",
        "https://github.com/Auspexlabs/writer/releases/latest/download/latest.json"
      ]
    }
  }
}
