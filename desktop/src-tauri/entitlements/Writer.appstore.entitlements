<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store. The engine runs as a child with com.apple.security.inherit, so everything it needs is granted here:
     it listens on 127.0.0.1 (network.server), the assistant calls the user's model API (network.client), and documents
     are the files and folders the user opens or picks (user-selected, kept across launches as app-scoped bookmarks).
     TEAM_ID is filled in by scripts/release-mac.sh. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>TEAM_ID.cn.thewriter.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAM_ID</string>
</dict>
</plist>
