<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's Info.plist by `tauri build`. Tauri's fileAssociations cannot give each type its own icon,
     so the document types are declared here; the .icns files are copied by bundle.macOS.files in tauri.conf.json. -->
<plist version="1.0">
<dict>
	<!-- The app is Chinese or English (设置 › 语言); listing both lets AppKit's own items (服务、搜索、进入全屏幕、打开面板) follow it: main.rs sets AppleLanguages to match. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<!-- Only the system's HTTPS (to the AI provider the user configures): exempt, so TestFlight and the store ask nothing. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Word 文档</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.wordprocessingml.document</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>word.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Excel 表格</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>excel.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PowerPoint 演示文稿</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.presentationml.presentation</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>ppt.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown 文稿</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>markdown.icns</string>
		</dict>
		<!-- .mm is also Objective-C++ source (public.objective-c-plus-plus-source, claimed by Xcode), so the mind maps
		     are claimed by extension, as an alternate: Writer appears in 打开方式 without taking over Xcode's files. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>思维导图</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>mm</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>mindmap.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF 文稿</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>pdf.icns</string>
		</dict>
		<!-- Compatibility formats: opened as a Word, Excel or PowerPoint draft (Office's compatibility mode), never written
		     back, so Writer is an alternate for them — it appears in 打开方式 without taking the types over from Office, WPS
		     or TextEdit. The list mirrors Adapters.OpensAs in the engine and DOC_EXTS in main.rs. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Word 97-2003 文档</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.word.doc</string>
				<string>org.openxmlformats.wordprocessingml.document.macroenabled</string>
				<string>org.openxmlformats.wordprocessingml.template</string>
				<string>org.openxmlformats.wordprocessingml.template.macroenabled</string>
				<string>org.oasis-open.opendocument.text</string>
				<string>org.oasis-open.opendocument.text-template</string>
				<string>public.rtf</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>doc</string>
				<string>dot</string>
				<string>wps</string>
				<string>wpt</string>
				<string>docm</string>
				<string>dotx</string>
				<string>dotm</string>
				<string>odt</string>
				<string>ott</string>
				<string>rtf</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>word.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Excel 97-2003 表格</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.excel.xls</string>
				<string>org.openxmlformats.spreadsheetml.sheet.macroenabled</string>
				<string>org.openxmlformats.spreadsheetml.template</string>
				<string>org.openxmlformats.spreadsheetml.template.macroenabled</string>
				<string>org.oasis-open.opendocument.spreadsheet</string>
				<string>org.oasis-open.opendocument.spreadsheet-template</string>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>xls</string>
				<string>xlt</string>
				<string>et</string>
				<string>ett</string>
				<string>xlsm</string>
				<string>xltx</string>
				<string>xltm</string>
				<string>ods</string>
				<string>ots</string>
				<string>csv</string>
				<string>tsv</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>excel.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PowerPoint 97-2003 演示文稿</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.powerpoint.ppt</string>
				<string>org.openxmlformats.presentationml.presentation.macroenabled</string>
				<string>org.openxmlformats.presentationml.template</string>
				<string>org.openxmlformats.presentationml.template.macroenabled</string>
				<string>org.openxmlformats.presentationml.slideshow</string>
				<string>org.openxmlformats.presentationml.slideshow.macroenabled</string>
				<string>org.oasis-open.opendocument.presentation</string>
				<string>org.oasis-open.opendocument.presentation-template</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>ppt</string>
				<string>pot</string>
				<string>pps</string>
				<string>dps</string>
				<string>dpt</string>
				<string>pptm</string>
				<string>potx</string>
				<string>potm</string>
				<string>ppsx</string>
				<string>ppsm</string>
				<string>odp</string>
				<string>otp</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>ppt.icns</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>文本与网页</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
				<string>public.html</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>txt</string>
				<string>html</string>
				<string>htm</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>markdown.icns</string>
		</dict>
	</array>
</dict>
</plist>
