{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": ["default", "writer-win-shell"]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Writer",
        "decorations": false,
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/windows/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://thewriter.cn/updates/windows/latest.json",
        "https://github.com/Auspexlabs/writer/releases/latest/download/latest.json"
      ]
    }
  }
}
