# /etc/caddy/Caddyfile on the website server, installed by deploy.sh.
# Caddy obtains and renews the HTTPS certificates by itself; HTTP redirects to HTTPS.
thewriter.cn, www.thewriter.cn {
	root * /srv/writer/site
	encode zstd gzip
	# Public static dashboard and aggregate JSON; only click recording needs the service.
	@stats_data path /stats/data.json /api/download-stats
	handle @stats_data {
		root * /srv/writer/public-stats
		rewrite * /data.json
		header Cache-Control "no-cache"
		file_server
	}
	reverse_proxy /api/download-clicks 127.0.0.1:8787
	# /download/mac and /download/windows → the current installers, written by deploy.sh --dmg and --exe
	import /srv/writer/redirects.caddy
	header /download/latest.json Cache-Control no-cache
	# The app asks /updates/<platform>/latest.json before GitHub and falls back only on an error or non-2xx:
	# a missing file must stay a plain 404 (file_server does that). Never add a fallback page or 204 here.
	header /updates/* Cache-Control no-cache
	file_server
}
