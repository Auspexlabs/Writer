# /etc/caddy/Caddyfile on the website server, installed by deploy.sh.
# Until the ICP filing is approved the site answers plain HTTP on the server's IP.
# Once it is approved, replace ":80" with "thewriter.cn, www.thewriter.cn" and redeploy:
# Caddy then obtains and renews the HTTPS certificates by itself.
:80 {
	root * /srv/writer/site
	encode zstd gzip
	# /download/mac → the current Writer-<version>-mac.dmg, written by deploy.sh --dmg
	import /srv/writer/redirects.caddy
	header /download/latest.json Cache-Control no-cache
	header /updates/* Cache-Control no-cache
	file_server
}
