<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>writer</AssemblyName>
    <RootNamespace>Writer.Cli</RootNamespace>
    <!-- the release engine is NativeAOT: every build reports what AOT would refuse (warnings are errors) -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Writer.Core/Writer.Core.csproj" />
    <ProjectReference Include="../Writer.Formats/Writer.Formats.csproj" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

</Project>
